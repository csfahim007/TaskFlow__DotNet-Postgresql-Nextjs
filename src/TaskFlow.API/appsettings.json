{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=taskflow_db;Username=taskflow_user;Password=taskflow_pass;"
  },
  "Jwt": {
    "SecretKey": "ThisIsAVerySecureSecretKeyForTaskFlowApp2024!MustBe32CharsMin",
    "Issuer": "TaskFlowAPI",
    "Audience": "TaskFlowClient",
    "AccessTokenMinutes": "15",
    "RefreshTokenDays": "7"
  },
  "AllowedOrigins": "http://localhost:3000",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/taskflow-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  },
  "Redis": {
    "ConnectionString": ""
  },
  "RabbitMq": {
    "Uri": ""
  },
  "RateLimiting": {
    "RequestsPerMinute": 600,
    "AuthRequestsPerMinute": 20
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  }
}