{
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=taskflow_db;Username=taskflow_user;Password=taskflow_pass;"
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "TaskFlowAPI",
    "Audience": "TaskFlowClient",
    "AccessTokenMinutes": "15",
    "RefreshTokenDays": "7"
  },
  "AllowedOrigins": "${ALLOWED_ORIGINS}",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/taskflow-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}